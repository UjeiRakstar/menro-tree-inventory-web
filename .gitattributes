# Line endings: text is stored with LF, as everything in the repository
# already is, and checked out with LF on every machine — so a one-line change
# stays a one-line diff, whoever's computer it was made on.
* text=auto eol=lf

# Windows scripts want CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never touched, never diffed as text.
*.png   binary
*.PNG   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.zip   binary
*.woff  binary
*.woff2 binary
