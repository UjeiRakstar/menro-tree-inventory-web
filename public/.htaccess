# Apache (e.g. the province's own server): every address that is not a real
# file or folder is the app (a single-page app).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# In testing: kept out of search results — every file, images and PDFs too,
# not only the pages. GOING_LIVE.md, part E, says when to remove it.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
